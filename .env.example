# Configuración de Resend para envío de correos masivos
RESEND_API_KEY=tu_api_key_aqui

# Configuración de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Configuración de base de datos (opcional para almacenar listas de contactos)
DATABASE_URL=postgresql://usuario:password@localhost:5432/email_campaigns

# Configuración de límites de envío
MAX_EMAILS_PER_BATCH=100
MAX_EMAILS_PER_HOUR=1000
DELAY_BETWEEN_BATCHES=1000

# Configuración de remitente por defecto
DEFAULT_FROM_EMAIL=noreply@tudominio.com
DEFAULT_FROM_NAME=Tu Empresa

# Configuración de webhooks (opcional)
WEBHOOK_SECRET=tu_webhook_secret_aqui