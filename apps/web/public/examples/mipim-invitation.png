<svg width="450" height="300" viewBox="0 0 450 300" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="450" height="300" fill="#f8fafc"/>
  
  <!-- Header -->
  <rect x="0" y="0" width="450" height="80" fill="#1e40af"/>
  
  <!-- MIPIM Logo Area -->
  <rect x="20" y="20" width="60" height="40" rx="8" fill="#ffffff" fill-opacity="0.2"/>
  <text x="50" y="45" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14" font-weight="bold">MIPIM</text>
  
  <!-- Title -->
  <text x="225" y="45" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">Invitación Exclusiva</text>
  
  <!-- Content Area -->
  <rect x="40" y="100" width="370" height="160" rx="12" fill="white" stroke="#e2e8f0" stroke-width="1"/>
  
  <!-- Event Details -->
  <text x="60" y="130" fill="#1e293b" font-family="Arial, sans-serif" font-size="16" font-weight="bold">MIPIM 2026 México</text>
  <text x="60" y="150" fill="#64748b" font-family="Arial, sans-serif" font-size="12">10 de Septiembre, 2025</text>
  <text x="60" y="170" fill="#64748b" font-family="Arial, sans-serif" font-size="12">Ciudad de México</text>
  
  <!-- CTA Button -->
  <rect x="60" y="190" width="140" height="40" rx="8" fill="#3b82f6"/>
  <text x="130" y="215" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14" font-weight="bold">Confirmar Asistencia</text>
  
  <!-- Decorative Elements -->
  <circle cx="350" cy="140" r="30" fill="#f1f5f9"/>
  <circle cx="380" cy="180" r="20" fill="#e2e8f0"/>
  <circle cx="320" cy="200" r="15" fill="#f8fafc"/>
  
  <!-- Footer -->
  <text x="225" y="280" text-anchor="middle" fill="#94a3b8" font-family="Arial, sans-serif" font-size="10">Powered by React Email</text>
</svg>